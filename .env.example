# =============================================================================
# Farg'ona Tuman Murojaatlar Tizimi (FTMT) - Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# All values below are PLACEHOLDERS only.
# =============================================================================

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Polling mode is used by the current runtime. Leave this empty.
TELEGRAM_WEBHOOK_URL=
# Secret token for webhook verification (generate a random string)
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-secret

# --- Database ---
# Local development (SQLite). Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./ftmt.db
# Required by Docker Compose. Use a long URL-safe value (letters, digits, - and _).
DB_PASSWORD=replace-with-a-long-random-url-safe-password

# --- Admin Panel ---
# Secret key for session signing. Generate a random string (e.g., using: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SECRET_KEY=change-me-to-a-random-secret-key-of-at-least-32-chars
# Session lifetime in seconds (default: 8 hours)
ADMIN_SESSION_LIFETIME=28800

# --- Initial Super Admin ---
# 1. Create a password and username. DO NOT share this password in chat.
# 2. Get your Telegram User ID (use bots like @userinfobot) and set it here.
# The system will automatically create the first super admin on startup using these credentials.
INITIAL_ADMIN_TELEGRAM_ID=
INITIAL_ADMIN_USERNAME=super_admin
INITIAL_ADMIN_PASSWORD=change-me-immediately-to-a-strong-password

# --- Application Settings ---
# Application environment: development, staging, production
APP_ENV=development
SEED_DEMO_DATA=false
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Timezone for display (storage is always UTC)
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Rate Limiting ---
# Maximum complaints per user per 24 hours
MAX_COMPLAINTS_PER_DAY=3
# Login attempt limit before lockout
MAX_LOGIN_ATTEMPTS=5
# Login lockout duration in seconds (15 minutes)
LOGIN_LOCKOUT_SECONDS=900

# --- File Uploads ---
# Maximum file size in bytes (20MB = Telegram limit)
MAX_FILE_SIZE=20971520
# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,mp4

# --- Deadlines (in calendar days) ---
# These are PROVISIONAL defaults. Must be confirmed with lawyer/hokimlik.
DEFAULT_ARIZA_DEADLINE_DAYS=15
DEFAULT_SHIKOYAT_DEADLINE_DAYS=15
DEFAULT_TAKLIF_DEADLINE_DAYS=30
FORWARDING_DEADLINE_DAYS=5

# --- Optional personal data fields ---
# Keep disabled until the hokimlik/legal basis and retention period are approved.
REQUIRE_BIRTH_DATE=false
REQUIRE_PASSPORT_DATA=false

# --- Optional Integrations (not implemented, placeholders) ---
# SMS_GATEWAY_URL=
# SMS_GATEWAY_API_KEY=
# SSO_PROVIDER_URL=
# ANTIVIRUS_SCAN_URL=
