# =============================================================================
# Farg'ona Tuman Murojaatlar Tizimi (FTMT) - Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# All values below are PLACEHOLDERS only.
# =============================================================================

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=0000000000:XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Webhook mode (production). Leave empty for polling mode (development).
TELEGRAM_WEBHOOK_URL=
# Secret token for webhook verification (generate a random string)
TELEGRAM_WEBHOOK_SECRET=change-me-to-random-secret

# --- Database ---
# For development (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./ftmt.db
# For production (PostgreSQL), uncomment and configure:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ftmt_db

# --- Admin Panel ---
# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_hex(32))")
ADMIN_SECRET_KEY=change-me-to-random-secret-key-at-least-32-chars
# Session lifetime in seconds (default: 8 hours)
ADMIN_SESSION_LIFETIME=28800

# --- Initial Super Admin ---
# Telegram user ID of the initial super admin (numeric)
INITIAL_ADMIN_TELEGRAM_ID=000000000
# Initial admin login credentials (change immediately after first login)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-immediately

# --- Application Settings ---
# Application environment: development, staging, production
APP_ENV=development
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Timezone for display (storage is always UTC)
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Rate Limiting ---
# Maximum complaints per user per 24 hours
MAX_COMPLAINTS_PER_DAY=3
# Login attempt limit before lockout
MAX_LOGIN_ATTEMPTS=5
# Login lockout duration in seconds (15 minutes)
LOGIN_LOCKOUT_SECONDS=900

# --- File Uploads ---
# Maximum file size in bytes (20MB = Telegram limit)
MAX_FILE_SIZE=20971520
# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,mp4

# --- Deadlines (in calendar days) ---
# These are PROVISIONAL defaults. Must be confirmed with lawyer/hokimlik.
DEFAULT_ARIZA_DEADLINE_DAYS=15
DEFAULT_SHIKOYAT_DEADLINE_DAYS=15
DEFAULT_TAKLIF_DEADLINE_DAYS=30
FORWARDING_DEADLINE_DAYS=5

# --- Optional Integrations (not implemented, placeholders) ---
# SMS_GATEWAY_URL=
# SMS_GATEWAY_API_KEY=
# SSO_PROVIDER_URL=
# ANTIVIRUS_SCAN_URL=
